generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Book {
  id           String            @id @default(cuid())
  slug         String            @unique
  // "draft" | "published" — SQLite has no enums, constrained by Zod (src/lib/validation/book.ts)
  status       String            @default("draft")
  // Relative path inside UPLOADS_DIR, e.g. "books/<id>/cover.webp"
  coverImage   String?
  publishedAt  DateTime?
  sortOrder    Int               @default(0)
  // Free-form JSON for ad-hoc/experimental parameters (see skill add-book-field)
  extras       String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  translations BookTranslation[]
  previewPages BookPreviewPage[]
}

model BookTranslation {
  id       String @id @default(cuid())
  bookId   String
  // "fr" | "en"
  locale   String
  title    String
  synopsis String
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, locale])
}

model BookPreviewPage {
  id        String @id @default(cuid())
  bookId    String
  // Relative path inside UPLOADS_DIR, e.g. "books/<id>/preview-<cuid>.webp"
  imagePath String
  sortOrder Int    @default(0)
  book      Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
