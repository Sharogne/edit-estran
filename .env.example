# --- Content file: the whole site lives here (texts + images), no database ---
# Dev: ./data/content.json — Prod (OVH VPS): /srv/edit/shared/content.json
# Backup = copy this one file.
CONTENT_FILE="./data/content.json"

# --- Session (iron-session) — MUST be a random string of at least 32 chars ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-random-string-of-at-least-32-chars"

# --- Admin account (the only one — there is no user table) ---
# Generate the value with: node scripts/hash-password.mjs "<password>"
# It is the bcrypt hash, base64-encoded: a raw hash is full of "$", and the env
# loaders expand "$name" — @next/env re-expands even what dotenv-cli resolved,
# which silently truncates the hash. Base64 has no "$" and survives every layer.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH_B64="replace-me-with-the-output-of-hash-password"

# --- Environnement : "production" est la SEULE valeur qui autorise
# l'indexation par les moteurs. Toute autre valeur (ou l'absence de valeur)
# ferme robots.txt et affiche un bandeau dans le back office.
SITE_ENV="production"

# --- Public site URL (used for SEO metadata, sitemap, hreflang) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
