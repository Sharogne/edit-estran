# --- Database (SQLite, path relative to prisma/schema.prisma) ---
DATABASE_URL="file:../data/app.db"

# --- Session (iron-session) — MUST be a random string of at least 32 chars ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-random-string-of-at-least-32-chars"

# --- Uploads directory (absolute or relative to the app working directory) ---
# Dev (Windows/macOS/Linux): ./data/uploads — Prod (OVH VPS): /srv/edit/shared/uploads
UPLOADS_DIR="./data/uploads"

# --- Admin account created/updated by `npm run db:seed` ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong-password"

# --- Public site URL (used for SEO metadata, sitemap, hreflang) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
