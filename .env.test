# Environment used by the e2e test suite (npm run e2e / e2e:open).
# Committed on purpose: contains no real secrets, only deterministic test values.
CONTENT_FILE="./data/test-content.json"
SESSION_SECRET="e2e-only-session-secret-0123456789abcdef0123456789abcdef"
SESSION_COOKIE_SECURE="false"
ADMIN_EMAIL="admin@e2e.local"
# The app checks the hash; Cypress types the plaintext (cypress.config.ts reads
# it from here). The hash is base64 — see .env.example.
ADMIN_PASSWORD="e2e-Password-123"
ADMIN_PASSWORD_HASH_B64="JDJiJDEyJHhxS2Jpd3FlSXo5Nk0uMkRGZ1RjS2VpeTYubXRRdFZUTGJzNlB2ME9sd1RWLnRXSTRZT2ZL"
# La suite teste le robots.txt de production ; le cas staging est vérifié par
# le script de déploiement, qui refuse de laisser un site de test indexable.
SITE_ENV="production"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
